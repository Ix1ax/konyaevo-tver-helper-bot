# Токен Telegram бота от @BotFather (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Имя бота (необязательно)
BOT_USERNAME=konyaevo_tver_helper_bot

# Telegram ID администраторов через запятую (для команд /admin, /stats, /broadcast, /refresh)
BOT_ADMIN_IDS=1669683599

# Базовый URL Telegram Bot API (по умолчанию: https://api.telegram.org/bot)
# При использовании локального SOCKS5/HTTP прокси оставить стандартный!
BOT_BASE_URL=https://api.telegram.org/bot

# Прокси для обхода блокировок Telegram (необязательно)
# Тип: NO_PROXY (по умолчанию), SOCKS5 или HTTP (например, через Xray / Happ)
BOT_PROXY_TYPE=NO_PROXY
BOT_PROXY_HOST=127.0.0.1
BOT_PROXY_PORT=10808

# База данных H2 (путь и пароль)
DB_URL=jdbc:h2:file:./data/konyaevo-bot
DB_PASSWORD=your_secure_password_here
