# Токен Telegram бота от @BotFather (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Имя бота (необязательно)
BOT_USERNAME=konyaevo_tver_helper_bot

# Telegram ID администраторов через запятую (для команд /admin, /stats, /broadcast, /refresh)
BOT_ADMIN_IDS=1669683599

# Маршруты до Telegram. Бот ходит основным, а если до него нет соединения — запасным,
# и сам возвращается на основной, когда тот оживёт. API и Mini App работают, даже если недоступны оба.
# Основной: адрес Bot API (по умолчанию https://api.telegram.org/bot) и прокси к нему.
# Через Cloudflare Worker: BOT_BASE_URL=https://<worker>.workers.dev/bot и BOT_PROXY_TYPE=NO_PROXY.
BOT_BASE_URL=https://api.telegram.org/bot
# Тип: NO_PROXY (по умолчанию), SOCKS5, SOCKS4 или HTTP (например, локальный xray)
BOT_PROXY_TYPE=NO_PROXY
BOT_PROXY_HOST=127.0.0.1
BOT_PROXY_PORT=10808

# Запасной маршрут (необязательно). Достаточно указать прокси: адрес по умолчанию api.telegram.org.
BOT_FALLBACK_BASE_URL=
BOT_FALLBACK_PROXY_TYPE=NO_PROXY
BOT_FALLBACK_PROXY_HOST=127.0.0.1
BOT_FALLBACK_PROXY_PORT=10808

# Ссылка VPN для локального xray на сервере, строго в одинарных кавычках: в ней есть & и #,
# без кавычек start.sh не загрузит .env. Применяется командой ./deploy/xray/set-vpn.sh
VPN_URL=

# База данных H2 (путь и пароль)
DB_URL=jdbc:h2:file:./data/konyaevo-bot
DB_PASSWORD=your_secure_password_here

# Порт веб-сервера для REST API (для Mini App)
SERVER_PORT=8090

# URL развернутого Telegram Mini App (например: https://konyaevo-mini-app.pages.dev)
# Если указан, в меню бота появится кнопка "📱 Mini App"
MINI_APP_URL=https://your-mini-app.pages.dev

# ImageKit: пустой ключ оставляет прежнее временное хранение JPEG в RAM.
# Секрет хранить только в .env бэкенда; никогда в VITE_*.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
