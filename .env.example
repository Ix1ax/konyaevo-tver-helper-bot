# Токен Telegram бота от @BotFather (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Имя бота (необязательно)
BOT_USERNAME=konyaevo_tver_helper_bot

# Кастомный базовый URL Telegram Bot API (например, Cloudflare Worker или обратный прокси)
# По умолчанию: https://api.telegram.org/bot
BOT_BASE_URL=https://konyaevo-tver-helper-bot.ixlax.workers.dev/bot

# База данных H2 (путь и пароль)
DB_URL=jdbc:h2:file:./data/konyaevo-bot
DB_PASSWORD=your_secure_password_here
